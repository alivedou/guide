# =========================================================================
# CloudNav 环境变量配置模板 (.env.example)
# 请复制此文件并重命名为 .env，然后填写对应的变量值。
# ⚠️ 注意：不要将含有真实密钥的 .env 文件提交到 GitHub 仓库中！
# =========================================================================

# 1. 单用户版遗留变量 (在当前 D1 多用户系统中已无需配置)
# 当前系统的首位管理员 (Root Admin) 采用“首位注册即自动提拔”的物理鉴权机制。
# 此处的 TOKEN 仅作向后兼容性占位，可直接忽略或留空。
TOKEN=

# 2. JWT 权限认证会话密钥 (用于多用户 JWT 加密签名与校验)
# 生产部署时强烈建议修改为任意 32 位及以上高强度随机密钥。
JWT_SECRET=cloudnav-secret-2026

# 3. Telegram 机器人通知配置 (用于系统异常实时告警 & 定时每日审计日报)
# 【BOT TOKEN】: 全局 Bot API Token，锁死在后端，不泄露至前端 (如 123456789:ABCdefGhI...)
# 🚀 进阶：为防高频 Rate Limit 限限，系统支持多 Bot 轮载。若需配置多个 Bot，请以半角逗号“,”分隔无缝填写多个 Token (例如: 123456:ABC,789012:DEF...)
TELEGRAM_BOT_TOKEN=
# 【CHAT ID】: Fallback 备用/全局通知接收频道或个人会话 ID (如 -1001234567890 或 123456789)
# 🚀 进阶：若要向多用户私信群发，系统会自动联表读取各用户自己绑定的 TG ID；这里的 CHAT_ID 仅用于系统对公共频道或管理大群的广播。
TELEGRAM_CHAT_ID=

# 4. 邮件通知分发配置 (用于基于 Resend API 的安全邮件派发，可选)
# 【RESEND API KEY】: 来自 https://resend.com 的发信发信密钥 (如 re_abc123_DEF...)
RESEND_API_KEY=
# 【EMAIL FROM】: 发件人邮箱，需与 Resend 控制台中绑定的发信域名一致
EMAIL_FROM=alerts@yourdomain.tech

# 5. Cloudflare 定时日报定时器触发安全密钥
# 用于阻断第三方恶意刷新日报端点，触发时必须在 Headers 中携带 x-cron-secret。
CRON_SECRET=cloudnav-cron-secret-secure-key

